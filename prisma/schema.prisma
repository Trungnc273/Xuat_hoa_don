datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id            String         @id @default(uuid())
  username      String         @unique
  email         String         @unique
  password      String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  notifications Notification[]
  activityLogs  ActivityLog[]
  quotations    Quotation[]    @relation("QuotationCreator")
  invoices      Invoice[]      @relation("InvoiceCreator")
  receipts      Receipt[]      @relation("ReceiptReceiver")
  payments      Payment[]      @relation("PaymentPayor")
  expenses      Expense[]      @relation("ExpensePayor")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // ADMIN, MANAGER, ACCOUNTANT, STAFF
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  action      String           // CREATE, READ, UPDATE, DELETE, ALL, APPROVE
  subject     String           // Customer, Product, Invoice, Setting, v.v.
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Customer {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id            String      @id @default(uuid())
  code          String      @unique // KH000001
  name          String
  company       String?
  taxCode       String?
  address       String?
  email         String?
  phone         String?
  contactPerson String?
  tagName       String?
  tagColor      String?
  note          String?
  quotations    Quotation[]
  invoices      Invoice[]
  receipts      Receipt[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("customers")
}

model Supplier {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id            String    @id @default(uuid())
  code          String    @unique // NCC000001
  name          String
  company       String?
  taxCode       String?
  address       String?
  email         String?
  phone         String?
  contactPerson String?
  note          String?
  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("suppliers")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id             String          @id @default(uuid())
  sku            String?         @unique
  code           String          @unique // SP000001
  barcode        String?         @unique
  name           String
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  importPrice    Float
  salePrice      Float
  vatRate        Float           @default(10) // E.g. 10
  unit           String          @default("Cái")
  images         String[]
  description    String?
  stock          Int             @default(0)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("products")
}

model Warehouse {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id             String          @id @default(uuid())
  code           String          @unique // KHO000001
  name           String
  address        String?
  description    String?
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("warehouses")
}

model StockMovement {
  id          String    @id @default(uuid())
  type        String    // IN, OUT, CHECK, ADJUST
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  prevStock   Int
  newStock    Int
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  reason      String?
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@map("stock_movements")
}

model Quotation {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id             String          @id @default(uuid())
  code           String          @unique // BG000001
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  date           DateTime        @default(now())
  dueDate        DateTime?
  creatorId      String
  creator        User            @relation("QuotationCreator", fields: [creatorId], references: [id])
  status         String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED
  notes          String?
  subtotal       Float
  vatAmount      Float
  discountAmount Float           @default(0)
  total          Float
  items          QuotationItem[]
  invoices       Invoice[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("quotations")
}

model QuotationItem {
  id           String    @id @default(uuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId    String?
  productName  String
  productSku   String?
  description  String?
  unitPrice    Float
  vatRate      Float     @default(10)
  discountRate Float     @default(0)
  quantity     Int
  amount       Float

  @@map("quotation_items")
}

model Invoice {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id              String        @id @default(uuid())
  code            String        @unique // HD000001
  quotationId     String?
  quotation       Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  date            DateTime      @default(now())
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  creatorId       String
  creator         User          @relation("InvoiceCreator", fields: [creatorId], references: [id])
  status          String        @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  notes           String?
  subtotal        Float
  vatAmount       Float
  discountAmount  Float         @default(0)
  total           Float
  paidAmount      Float         @default(0)
  remainingAmount Float
  qrCode          String?
  templateName    String        @default("DEFAULT") // DEFAULT, MODERN, MINIMAL
  items           InvoiceItem[]
  receipts        Receipt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id           String  @id @default(uuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String?
  productName  String
  productSku   String?
  unitPrice    Float
  vatRate      Float   @default(10)
  discountRate Float   @default(0)
  quantity     Int
  amount       Float

  @@map("invoice_items")
}

model Receipt {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id            String    @id @default(uuid())
  code          String    @unique // PT000001
  invoiceId     String?
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount        Float
  date          DateTime  @default(now())
  paymentMethod String    // CASH, BANK_TRANSFER, CARD
  receiverId    String
  receiver      User      @relation("ReceiptReceiver", fields: [receiverId], references: [id])
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("receipts")
}

model Payment {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id            String    @id @default(uuid())
  code          String    @unique // PC000001
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  amount        Float
  date          DateTime  @default(now())
  paymentMethod String    // CASH, BANK_TRANSFER, CARD
  payorId       String
  payor         User      @relation("PaymentPayor", fields: [payorId], references: [id])
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("payments")
}

model Expense {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id            String   @id @default(uuid())
  code          String   @unique // CP000001
  title         String
  category      String   // OFFICE, MARKETING, SALARY, TRAVEL, UTILITIES, OTHER
  amount        Float
  date          DateTime @default(now())
  payorId       String
  payor         User     @relation("ExpensePayor", fields: [payorId], references: [id])
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("expenses")
}

model Setting {
  organizationId String? // để cửa multi-tenant (ADR-002), chưa dùng
  id             String   @id @default(uuid())
  logo           String?
  companyName    String
  taxCode        String?
  address        String?
  email          String?
  phone          String?
  website        String?
  bankAccount    String?
  representative String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("settings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

// Bộ đếm mã chứng từ — sinh mã atomic trong transaction, thay cho count()+1 (xem SPEC GĐ1, FR-2)
model DocumentCounter {
  prefix     String @id // HD, BG, PT, PC, SP, KH, NCC, KHO, CP
  lastNumber Int    @default(0)

  @@map("document_counters")
}

// Tổ chức/doanh nghiệp — 'để cửa' cho multi-tenant tương lai (ADR-002). Chưa có logic sử dụng.
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}
